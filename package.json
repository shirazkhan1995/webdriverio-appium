{
  "name": "webdriverio-appium",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@wdio/allure-reporter": "^9.31.2",
    "@wdio/appium-service": "^9.31.3",
    "@wdio/cli": "^9.31.3",
    "@wdio/local-runner": "^9.31.3",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/visual-service": "^10.1.0",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.5.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check:node": "node scripts/check-node.mjs",
    "fetch:app": "node scripts/fetch-app.mjs",
    "pretest": "npm run check:node",
    "test": "wdio run ./wdio.conf.ts",
    "pretest:headless": "npm run check:node",
    "test:headless": "cross-env ANDROID_HEADLESS=1 wdio run ./wdio.conf.ts",
    "prewdio": "npm run check:node",
    "wdio": "wdio run ./wdio.conf.ts",
    "emulator": "node scripts/emulator.mjs",
    "emulator:headless": "node scripts/emulator.mjs --headless",
    "emulator:stop": "node scripts/emulator-stop.mjs",
    "devices": "node scripts/devices.mjs",
    "preappium:server": "npm run check:node",
    "appium:server": "node scripts/appium-server.mjs",
    "inspector": "node scripts/inspector.mjs",
    "allure:report": "allure generate allure-results -o allure-report && allure open allure-report"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "allure": "^3.16.0"
  }
}
