# Copy to .env and adjust. .env is gitignored — never commit machine-specific paths.
#
# Almost every value here is optional - leave a line commented out to use the
# default. ANDROID_HOME is the exception: see below.

# Android SDK location. `npm run setup` writes this for you.
#
# The scripts in scripts/ auto-detect it per platform when unset:
#   Linux    ~/Android/Sdk
#   macOS    ~/Library/Android/sdk
#   Windows  %LOCALAPPDATA%\Android\Sdk
#
# The Appium server does NOT. It reads the real environment and fails session
# creation with "Neither ANDROID_HOME nor ANDROID_SDK_ROOT environment variable
# was exported". So this has to be set somewhere real - here, or exported by
# your shell profile. Auto-detection is not enough on its own.
# ANDROID_HOME=/path/to/Android/Sdk
# ANDROID_SDK_ROOT=/path/to/Android/Sdk

# AVD to boot, or an `adb devices` serial to target a specific device.
# Must match an AVD that exists locally — see README for how to create one.
# ANDROID_DEVICE_NAME=wdio_android_34

# Must match the Android version of the target device/AVD.
# ANDROID_PLATFORM_VERSION=14

# Boot the emulator with no window.
# ANDROID_HEADLESS=1

# Path to the .apk under test. Defaults to the demo app fetched by
# `npm run fetch:app`. Set this to point at your own build.
# APP_PATH=/absolute/path/to/your.apk

# Path to Appium Inspector, if installed somewhere non-standard.
# APPIUM_INSPECTOR=/path/to/inspector
